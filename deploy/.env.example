# Chaves esperadas pelo docker-compose.prod.yml. Na EC2 os dois arquivos são
# gerados pelo deploy a cada execução; este exemplo só documenta o formato.

# ── .env ── sem segredo; o Compose lê para interpolar o arquivo.
API_IMAGE=<conta>.dkr.ecr.us-east-1.amazonaws.com/cinerini-api:<commit>
API_DOMAIN=<ip-com-hifens>.sslip.io
AWS_REGION=us-east-1
LOG_GROUP=/cinerini/api

# ── .env.api ── segredos, vindos do SSM Parameter Store (/cinerini/*).
# Permissão 600, só o root lê.
DATABASE_URL=postgresql+psycopg://cinerini:<senha>@<endpoint-do-rds>:5432/cinerini?sslmode=require
SECRET_KEY=
TMDB_API_KEY=
CORS_ORIGINS=https://cinerini.vercel.app
