# Copie para .env e preencha. O .env nunca é versionado.

DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco

# Assina os tokens de sessão e os códigos de ingresso.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Origens autorizadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Ligar apenas em produção, atrás do proxy da plataforma. Ligado sem proxy,
# o cliente forja o próprio IP e escapa do limite de tentativas.
TRUST_PROXY=false
