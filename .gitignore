# Segredos. Nunca versionar.
.env
.env.*
!.env.example

# Terraform: o estado registra o que existe na conta e fica só na máquina de
# quem aplica. O .terraform.lock.hcl vai versionado, para que todo `init`
# baixe a mesma versão do provider.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Variáveis pessoais (IP e e-mail); o formato está no .example.
*.tfvars

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Ferramentas de apoio (não fazem parte da entrega)
.superpowers/
.agents/
.claude/
.codex/
skills-lock.json

# As skills instaladas se espalham por .github/. O workflow continua
# versionado: é infraestrutura do projeto, não ferramenta de autoria.
.github/agents/
.github/hooks/
.github/skills/

# Enunciado do desafio: material da Verzel, não redistribuir
Desafio-Elite-Dev-2026.pdf

# Saída do servidor MCP do Playwright: capturas e árvores de página
# gravadas durante a conferência, regeneráveis a cada execução.
.playwright-mcp/

# Sistema
.DS_Store
Thumbs.db

# Protótipo de design: a imagem é artefato de processo e vai versionada.
# O arquivo de edição fica de fora: pesa megabytes e ninguém o abriria.
Prototipos/*.psd
